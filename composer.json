{
    "name": "trench94/puppr",
    "description": "Feature-module access control for modular Laravel SaaS applications. Define modules, grant them to users or teams, and guard routes, views and gates.",
    "keywords": [
        "laravel",
        "saas",
        "modules",
        "features",
        "feature-flags",
        "access-control",
        "authorization",
        "puppr",
        "trench94"
    ],
    "homepage": "https://github.com/trench94/puppr",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Luke Marshall",
            "email": "marshall0694@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/auth": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Trench94\\Puppr\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trench94\\Puppr\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Trench94\\Puppr\\PupprServiceProvider"
            ],
            "aliases": {
                "Puppr": "Trench94\\Puppr\\PupprFacade"
            }
        }
    }
}
